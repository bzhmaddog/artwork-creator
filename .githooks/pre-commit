#!/bin/sh
# Runs the same checks as the Quality workflow before each commit.
# Install with `make hooks`; skip once with `git commit --no-verify`.
set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --all --check || {
    echo "pre-commit: formatting is off; run 'make fmt' and stage the result." >&2
    exit 1
}

echo "pre-commit: cargo clippy"
cargo clippy --all-targets --locked -q -- -D warnings

echo "pre-commit: cargo test"
cargo test --locked -q
